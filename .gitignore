## .NET / Visual Studio / Rider gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# Visual Studio cache/options
.vs/
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage/

# Publish / deployment
[Pp]ublish/
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.pubxml.user
*.publishproj

# Rider/ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# User-specific files
*.rsuser
*.suo
*.userosscache
*.sap

# Others
*.log
*.tmp
*.bak
*.swp
*.DS_Store
Thumbs.db

# Environment / secrets
.env
.env.*
appsettings.Development.json
appsettings.*.local.json
secrets.json
*.pfx
*.pem

# Docker
docker-compose.override.yml

# EF Core migrations (uncomment if you want to exclude, usually NOT recommended)
# Migrations/

# Node (if using frontend within the same repo, e.g. wwwroot build tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# JetBrains Rider specific
*.sln.iml
